# --- required ---
JWT_SECRET=change-me-to-a-random-32-char-string
PORT=4001

# --- LLM provider: demo | openai | groq | together | ollama | lmstudio ---
# demo:     no key needed — extractive answers from retrieved chunks (always cited)
# ollama:   fully OFFLINE — run `ollama pull llama3.1:8b && ollama serve`, no key needed
# lmstudio: fully OFFLINE — LM Studio with a model loaded, no key needed
# openai/groq/together: set LLM_API_KEY
LLM_PROVIDER=demo
# Optional overrides (defaults come from the preset above):
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=

# --- embeddings: local (default, no key) or openai ---
EMBEDDING_PROVIDER=local
# OPENAI_API_KEY=

# --- optional: web fallback (answer from the internet when docs don't have it) ---
# Get a free key at https://brave.com/search/api/ — then toggle per knowledge base in Settings.
# BRAVE_API_KEY=

# --- demo seed on first boot ---
SEED_DEMO=true
